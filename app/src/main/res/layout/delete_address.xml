<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="20dp">


    <TextView
        android:id="@+id/textOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Confirmation"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textTwo"/>

    <TextView
        android:id="@+id/textTwo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="Are you sure you want to delete this address?"
        android:textColor="#999999"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textOne"
        app:layout_constraintBottom_toTopOf="@id/horizontalDivider"/>

    <View
        android:id="@+id/horizontalDivider"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:background="#999999"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/textTwo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/cancelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintHorizontal_weight="1"
        android:text="CANCEL"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#999999"
        app:layout_constraintTop_toTopOf="@id/horizontalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/verticalDivider"/>

    <View
        android:id="@+id/verticalDivider"
        android:layout_width="1dp"
        android:layout_height="25dp"
        android:background="#999999"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="@id/horizontalDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomSpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/deleteText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:text="DELETE"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FD4179"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="@id/horizontalDivider"
        app:layout_constraintStart_toEndOf="@id/verticalDivider"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/bottomSpace"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@id/verticalDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>