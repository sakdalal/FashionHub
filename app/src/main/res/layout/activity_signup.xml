<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.activity.SignupActivity">

    <View
        android:id="@+id/commonBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textHead"
        android:text="Enter Signup Details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="@id/commonBox"
        app:layout_constraintStart_toStartOf="@id/commonBox"
        app:layout_constraintBottom_toTopOf="@id/nameText"
        />

    <EditText
        android:id="@+id/nameText"
        android:textCursorDrawable="@drawable/cursor_pink"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Name"
        android:layout_marginTop="15dp"
        android:paddingStart="10dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#C4C4C4"
        android:gravity="center_vertical"
        android:background="@drawable/rectangular_border"
        android:enabled="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/textHead"
        app:layout_constraintStart_toStartOf="@id/commonBox"
        app:layout_constraintEnd_toEndOf="@id/commonBox"
        app:layout_constraintBottom_toTopOf="@id/phoneText"/>

    <EditText
        android:id="@+id/phoneText"
        android:textCursorDrawable="@drawable/cursor_pink"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Phone"
        android:layout_marginTop="15dp"
        android:paddingStart="10dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#C4C4C4"
        android:gravity="center_vertical"
        android:background="@drawable/rectangular_border"
        android:enabled="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/nameText"
        app:layout_constraintStart_toStartOf="@id/commonBox"
        app:layout_constraintEnd_toEndOf="@id/commonBox"
        app:layout_constraintBottom_toTopOf="@+id/emailText"/>

    <EditText

        android:id="@+id/emailText"
        android:textCursorDrawable="@drawable/cursor_pink"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Email"
        android:layout_marginTop="15dp"
        android:paddingStart="10dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#C4C4C4"
        android:gravity="center_vertical"
        android:background="@drawable/rectangular_border"
        android:enabled="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/phoneText"
        app:layout_constraintStart_toStartOf="@id/commonBox"
        app:layout_constraintEnd_toEndOf="@id/commonBox"
        app:layout_constraintBottom_toTopOf="@+id/passwordText"/>

    <EditText
        android:id="@+id/passwordText"
        android:textCursorDrawable="@drawable/cursor_pink"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Password"
        android:layout_marginTop="15dp"
        android:paddingStart="10dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#C4C4C4"
        android:gravity="center_vertical"
        android:background="@drawable/rectangular_border"
        android:enabled="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/emailText"
        app:layout_constraintStart_toStartOf="@id/commonBox"
        app:layout_constraintEnd_toEndOf="@id/commonBox"
        app:layout_constraintBottom_toTopOf="@id/signupBtn"/>

    <TextView
        android:id="@+id/signupBtn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="SIGNUP"
        android:textSize="20dp"
        android:textStyle="bold"
        android:background="@drawable/pink_bg"
        android:backgroundTint="#FF3F6C"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/passwordText"
        app:layout_constraintStart_toStartOf="@id/commonBox"
        app:layout_constraintEnd_toEndOf="@id/commonBox"/>

</androidx.constraintlayout.widget.ConstraintLayout>