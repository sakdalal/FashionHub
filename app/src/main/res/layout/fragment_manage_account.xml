<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mobileBox"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:background="@drawable/rectangular_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/mobileHead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="Mobile Number"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#808080"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@id/mobileBox"
        app:layout_constraintStart_toStartOf="@id/mobileBox"/>

    <TextView
        android:id="@+id/mobileText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:text="1234567890"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/mobileHead"
        app:layout_constraintStart_toStartOf="@id/mobileBox"/>

    <TextView
        android:id="@+id/requiredOne"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="REQUIRED"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FD4179"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/mobileBox"
        app:layout_constraintBottom_toBottomOf="@id/mobileBox"
        app:layout_constraintEnd_toEndOf="@id/mobileBox"/>


    <View
        android:id="@+id/nameBox"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:background="@drawable/rectangular_border"
        app:layout_constraintTop_toBottomOf="@id/mobileBox"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/nameHead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="Full Name"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#808080"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@id/nameBox"
        app:layout_constraintStart_toStartOf="@id/nameBox"/>

    <EditText
        android:id="@+id/nameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:inputType="text"
        android:gravity="center"
        android:enabled="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:text="Dean Laurentis"
        android:textColor="@color/black"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        android:background="@null"
        android:textColorHint="@color/black"
        app:layout_constraintTop_toBottomOf="@id/nameHead"
        app:layout_constraintStart_toStartOf="@id/nameBox"/>

    <View
        android:id="@+id/emailBox"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:background="@drawable/rectangular_border"
        app:layout_constraintTop_toBottomOf="@id/nameBox"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/emailHead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="Email"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#808080"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="@id/emailBox"
        app:layout_constraintStart_toStartOf="@id/emailBox"/>

    <TextView
        android:id="@+id/emailText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:text="dean@delaurentis.com"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/emailHead"
        app:layout_constraintStart_toStartOf="@id/emailBox"/>

    <TextView
        android:id="@+id/requiredTwo"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="REQUIRED"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FD4179"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/emailBox"
        app:layout_constraintBottom_toBottomOf="@id/emailBox"
        app:layout_constraintEnd_toEndOf="@id/emailBox"/>

    <View
        android:id="@+id/saveBox"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/pink_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/saveText"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="SAVE DETAILS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/saveBox"
        app:layout_constraintStart_toStartOf="@id/saveBox"
        app:layout_constraintBottom_toBottomOf="@id/saveBox"
        app:layout_constraintEnd_toEndOf="@id/saveBox"/>




</androidx.constraintlayout.widget.ConstraintLayout>