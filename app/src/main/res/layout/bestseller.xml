<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/border"
    android:padding="4dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:text="Day Cream"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sellImage"
        app:layout_constraintStart_toStartOf="@id/sellImage"
        app:layout_constraintEnd_toEndOf="@id/sellImage"/>
    <ImageView
        android:id="@+id/sellImage"
        android:layout_width="180dp"
        android:layout_height="250dp"
        android:src="@drawable/box"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/smallImg1"
        tools:ignore="MissingConstraints" />
    <TextView
        android:id="@+id/sellText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Under $299"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="@id/sellImage"
        app:layout_constraintEnd_toEndOf="@id/sellImage"
        app:layout_constraintBottom_toBottomOf="@id/sellImage"/>
    <ImageView
        android:id="@+id/smallImg1"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:src="@drawable/tinylogo"
        android:padding="3dp"
        android:layout_margin="3dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/sellImage"
        app:layout_constraintStart_toStartOf="@id/sellImage"
        app:layout_constraintEnd_toStartOf="@id/divider"/>
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="25dp"
        android:background="#808080"
        android:layout_margin="3dp"
        app:layout_constraintTop_toBottomOf="@id/sellImage"
        app:layout_constraintStart_toEndOf="@id/smallImg1"
        app:layout_constraintEnd_toStartOf="@id/smallImg2"/>
    <ImageView
        android:id="@+id/smallImg2"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:src="@drawable/tinylogo"
        android:padding="3dp"
        android:layout_margin="3dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintTop_toBottomOf="@id/sellImage"
        app:layout_constraintEnd_toEndOf="@id/sellImage"/>

</androidx.constraintlayout.widget.ConstraintLayout>