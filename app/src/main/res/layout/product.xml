<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:padding="2dp">


    <ImageView
        android:id="@+id/productImage"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:layout_margin="2dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/border"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/product"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ratingtag"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:padding="2dp"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/border"
        app:layout_constraintBottom_toBottomOf="@id/productImage"
        app:layout_constraintStart_toStartOf="@id/productImage"
        app:layout_constraintWidth_percent="0.4" />

    <TextView
        android:id="@+id/rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4.2"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@id/ratingtag"
        app:layout_constraintEnd_toStartOf="@id/star"
        app:layout_constraintStart_toStartOf="@id/ratingtag"
        app:layout_constraintTop_toTopOf="@+id/ratingtag" />

    <ImageView
        android:id="@+id/star"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/star"
        app:layout_constraintBottom_toBottomOf="@id/ratingtag"
        app:layout_constraintStart_toEndOf="@id/rate"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintTop_toTopOf="@id/ratingtag" />

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:background="#808080"
        app:layout_constraintBottom_toBottomOf="@id/ratingtag"
        app:layout_constraintEnd_toStartOf="@id/serial"
        app:layout_constraintStart_toEndOf="@id/star"
        app:layout_constraintTop_toTopOf="@id/ratingtag" />

    <TextView
        android:id="@+id/serial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8079"
        android:layout_marginEnd="2dp"
        app:layout_constraintTop_toTopOf="@id/ratingtag"
        app:layout_constraintBottom_toBottomOf="@id/ratingtag"
        app:layout_constraintEnd_toEndOf="@id/ratingtag"
        app:layout_constraintStart_toEndOf="@id/divider" />

    <ImageView
        android:id="@+id/heart"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="6dp"
        android:src="@drawable/heart"
        app:layout_constraintTop_toTopOf="@id/productImage"
        app:layout_constraintEnd_toEndOf="@id/productImage"/>

    <View
        android:id="@+id/cartTag"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintWidth_percent="0.4"
        android:background="@drawable/pink_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/companyName"/>


    <ImageView
        android:id="@+id/bag"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/pinkbag"
        app:layout_constraintTop_toTopOf="@id/cartTag"
        app:layout_constraintBottom_toBottomOf="@id/cartTag"
        app:layout_constraintStart_toStartOf="@id/cartTag"
        app:layout_constraintEnd_toStartOf="@id/add"/>

    <TextView
        android:id="@+id/add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FD4179"
        app:layout_constraintTop_toTopOf="@id/cartTag"
        app:layout_constraintEnd_toEndOf="@id/cartTag"
        app:layout_constraintStart_toEndOf="@id/bag"
        app:layout_constraintBottom_toBottomOf="@id/cartTag"/>

    <TextView
        android:id="@+id/companyName"
        android:text="QUIERO"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="16dp"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/productImage"
        app:layout_constraintTop_toBottomOf="@id/productImage"/>

    <TextView
        android:id="@+id/productName"
        android:text="Printed Tie-Up Shrug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#808080"
        android:textSize="14sp"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toBottomOf="@id/companyName"
        app:layout_constraintStart_toStartOf="@id/productImage" />
    <TextView
        android:id="@+id/bestPrice"
        android:text="Best Price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#17B169"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toBottomOf="@id/productName"
        app:layout_constraintStart_toStartOf="@id/productImage"
        app:layout_constraintEnd_toStartOf="@id/coupon"/>
    <TextView
        android:id="@+id/coupon"
        android:text="with coupon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#17B169"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@id/bestPrice"
        app:layout_constraintStart_toEndOf="@id/bestPrice" />


</androidx.constraintlayout.widget.ConstraintLayout>