<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/backArrow"
        android:layout_weight="1"
        android:layout_width="30dp"
        android:layout_height="40dp"
        android:src="@drawable/leftarrow"
        android:padding="2dp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/search_bar"/>

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:orientation="horizontal"
        android:background="@drawable/search_bg"
        app:layout_constraintEnd_toStartOf="@id/wishlistIcon"
        app:layout_constraintStart_toEndOf="@id/backArrow"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:src="@drawable/myntra"
            android:layout_marginLeft="7dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/search_bar"
            app:layout_constraintEnd_toStartOf="@id/searchArea"/>

        <EditText
            android:id="@+id/searchArea"
            android:layout_width="210dp"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:text="Search..."
            app:layout_constraintStart_toEndOf="@id/appIcon"
            app:layout_constraintEnd_toStartOf="@id/searchIcon"
            />

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:src="@drawable/search"
            android:scaleType="fitCenter"
            android:padding="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/searchArea"
            app:layout_constraintEnd_toEndOf="@id/search_bar"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/wishlistIcon"
        android:layout_weight="1"
        android:layout_width="30dp"
        android:layout_height="40dp"
        android:src="@drawable/heart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bagIcon"
        android:layout_marginEnd="12dp"/>


    <FrameLayout
        android:id="@+id/bagIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <ImageView
        android:id="@+id/accountIcon"
        android:layout_weight="1"
        android:layout_width="30dp"
        android:layout_height="40dp"
        android:src="@drawable/bag"
        android:padding="2dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/cartBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:background="@drawable/circle_bg"
            android:visibility="gone"/>

    </FrameLayout>



</androidx.constraintlayout.widget.ConstraintLayout>