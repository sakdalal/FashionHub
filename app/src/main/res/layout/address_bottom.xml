<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/bottomSpace"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#C4C4C4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/horizontalDivider"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/bottomSpace"
        android:background="#808080"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    
    <View
        android:id="@+id/cancelBox"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/horizontalDivider"
        app:layout_constraintWidth_percent="0.5" 
        app:layout_constraintStart_toStartOf="parent"/>
    
    <TextView
        android:id="@+id/cancelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#3B3B3B"
        android:text="CANCEL"
        app:layout_constraintTop_toTopOf="@id/cancelBox"
        app:layout_constraintBottom_toBottomOf="@id/cancelBox"
        app:layout_constraintStart_toStartOf="@id/cancelBox"
        app:layout_constraintEnd_toEndOf="@id/cancelBox"/>

    <View
        android:id="@+id/saveBox"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#808080"
        app:layout_constraintTop_toBottomOf="@id/horizontalDivider"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/saveText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:text="SAVE"
        app:layout_constraintTop_toTopOf="@id/saveBox"
        app:layout_constraintBottom_toBottomOf="@id/saveBox"
        app:layout_constraintStart_toStartOf="@id/saveBox"
        app:layout_constraintEnd_toEndOf="@id/saveBox"/>

</androidx.constraintlayout.widget.ConstraintLayout>