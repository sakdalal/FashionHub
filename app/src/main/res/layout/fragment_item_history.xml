<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderSection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C4C4C4">


    <ImageView
        android:id="@+id/productImage"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/dress"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/brandText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kotty"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/productImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/titleText"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="Women High-Rise Wide-Leg Pleated Pansts"
        android:layout_marginTop="10dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/brandText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/priceText"/>

    <TextView
        android:id="@+id/priceText"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="Price : $234"
        android:layout_marginTop="10dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/orderIdText"/>

    <TextView
        android:id="@+id/orderIdText"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="Order ID : #123276727523782382"
        android:layout_marginTop="10dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/priceText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/totalPriceBox"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/rounded_bg"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orderIdText"
        app:layout_constraintBottom_toTopOf="@id/sendToBox"/>

    <TextView
        android:id="@+id/totalPriceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:gravity="center"
        android:text="Total Order Price"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/totalPriceValue"
        app:layout_constraintStart_toStartOf="@id/totalPriceBox"
        app:layout_constraintTop_toTopOf="@id/totalPriceBox" />

    <TextView
        android:id="@+id/totalPriceValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$400.50"
        android:layout_marginStart="20dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/totalPriceBox"
        app:layout_constraintTop_toBottomOf="@id/totalPriceText"
        app:layout_constraintBottom_toBottomOf="@id/totalPriceBox"
        />

    <View
        android:id="@+id/sendToBox"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/rounded_bg"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/totalPriceBox"
        app:layout_constraintBottom_toTopOf="@id/orderDetailBox"/>

    <ImageView
        android:id="@+id/notifyIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/bell"
        android:background="#f8eefd"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/sendToBox"
        app:layout_constraintTop_toTopOf="@id/sendToBox"
        app:tint="#696969" />

    <TextView
        android:id="@+id/sendToText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:text="Updates sent to"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="@id/notifyIcon"
        app:layout_constraintStart_toEndOf="@id/notifyIcon"
        app:layout_constraintTop_toTopOf="@id/sendToBox" />

    <TextView
        android:id="@+id/callHead"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="Call"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/notifyIcon"
        app:layout_constraintStart_toStartOf="@id/notifyIcon"/>

    <TextView
        android:id="@+id/callValue"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="1234567890"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/callHead"
        app:layout_constraintStart_toStartOf="@id/notifyIcon"/>

    <TextView
        android:id="@+id/emailHead"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="20dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/notifyIcon"
        app:layout_constraintStart_toEndOf="@id/callHead"/>

    <TextView
        android:id="@+id/emailValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="dean@delaurentis.com"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/callHead"
        app:layout_constraintStart_toEndOf="@id/callValue"/>


    <View
        android:id="@+id/orderDetailBox"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/rounded_bg"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sendToBox"/>

    <ImageView
        android:id="@+id/orderIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/boxicon"
        android:background="#f8eefd"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/orderDetailBox"
        app:layout_constraintTop_toTopOf="@id/orderDetailBox"
        app:tint="#696969" />

    <TextView
        android:id="@+id/orderDetailText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:text="Order details"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="@id/orderIcon"
        app:layout_constraintStart_toEndOf="@id/orderIcon"
        app:layout_constraintTop_toTopOf="@id/orderDetailBox" />

    <TextView
        android:id="@+id/orderOnHead"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="Ordered On"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/orderIcon"
        app:layout_constraintStart_toStartOf="@id/orderIcon"/>

    <TextView
        android:id="@+id/orderOnValue"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="06 March 2026"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/orderOnHead"
        app:layout_constraintStart_toStartOf="@id/notifyIcon"/>

    <TextView
        android:id="@+id/orderIdHead"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="Order ID"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="20dp"
        android:textColor="#525252"
        app:layout_constraintTop_toBottomOf="@id/orderIcon"
        app:layout_constraintStart_toEndOf="@id/orderOnHead"/>

    <TextView
        android:id="@+id/orderIdValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#13626726236473473"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/orderOnHead"
        app:layout_constraintStart_toEndOf="@id/orderOnValue"/>






</androidx.constraintlayout.widget.ConstraintLayout>