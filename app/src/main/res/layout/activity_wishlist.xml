<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/backArrow"
        android:layout_weight="1"
        android:layout_width="30dp"
        android:layout_height="50dp"
        android:src="@drawable/leftarrow"
        android:padding="2dp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/wishlistHead"/>

    <TextView
        android:id="@+id/wishlistHead"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:gravity="center"
        android:text="Wishlist"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/backArrow"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/itemsHead"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:text="items"
        android:textColor="#999999"
        android:textSize="15sp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/backArrow"
        app:layout_constraintTop_toBottomOf="@id/wishlistHead"
        />

    <ImageView
        android:id="@+id/addToBagImg"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/bag"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wishlistRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/backArrow"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/emptyWishlistLayout"
        layout="@layout/wishlist_empty"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>