<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/productTopBar"
        layout="@layout/product_detail_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/productTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_marginTop="4dp"
            tools:context=".ui.activity.ProductDetailActivity">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:layout_margin="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dress"
                app:layout_constraintBottom_toTopOf="@id/brandName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/brandName"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:text="Brand Name"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/productImage" />

            <TextView
                android:id="@+id/brandTitle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:text="Essence Mascara Lash Princess"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/brandName"
                app:layout_constraintTop_toBottomOf="@id/productImage" />

            <View
                android:id="@+id/rateDetail"
                android:layout_width="60dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/green_bg"
                app:layout_constraintStart_toStartOf="@id/brandName"
                app:layout_constraintTop_toBottomOf="@id/brandName" />

            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="4.2"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/rateDetail"
                app:layout_constraintStart_toStartOf="@id/rateDetail"
                app:layout_constraintTop_toTopOf="@+id/rateDetail" />

            <ImageView
                android:id="@+id/star"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/whitestar"
                app:layout_constraintBottom_toBottomOf="@+id/rateDetail"
                app:layout_constraintEnd_toEndOf="@id/rateDetail"
                app:layout_constraintStart_toEndOf="@id/rating"
                app:layout_constraintTop_toTopOf="@id/rateDetail" />

            <TextView
                android:id="@+id/mrp"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:text="MRP"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/stock"
                app:layout_constraintEnd_toStartOf="@id/price"
                app:layout_constraintStart_toStartOf="@id/rateDetail"
                app:layout_constraintTop_toBottomOf="@id/rateDetail" />

            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:text="$259"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/discount"
                app:layout_constraintStart_toEndOf="@id/price"
                app:layout_constraintTop_toBottomOf="@id/rateDetail" />

            <TextView
                android:id="@+id/discount"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="35% OFF!"
                android:textColor="#FD4179"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/price"
                app:layout_constraintTop_toBottomOf="@id/rateDetail" />

            <TextView
                android:id="@+id/stock"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="In Stock"
                android:textColor="#ff9248"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/mrp"
                app:layout_constraintTop_toBottomOf="@id/mrp" />

            <View
                android:id="@+id/buyNow"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/pink_border"
                app:layout_constraintEnd_toStartOf="@id/addToBag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stock" />

            <ImageView
                android:id="@+id/wishlistImg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/heart"
                app:layout_constraintBottom_toBottomOf="@id/buyNow"
                app:layout_constraintEnd_toStartOf="@id/wishlistText"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@id/buyNow"
                app:layout_constraintTop_toTopOf="@id/buyNow"
                app:tint="#FD4179" />

            <TextView
                android:id="@+id/wishlistText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="Add to Wishlist"
                android:textColor="#FD4179"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/buyNow"
                app:layout_constraintEnd_toEndOf="@id/buyNow"
                app:layout_constraintStart_toEndOf="@id/wishlistImg"
                app:layout_constraintTop_toTopOf="@id/buyNow" />

            <View
                android:id="@+id/addToBag"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/pink_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/buyNow"
                app:layout_constraintTop_toBottomOf="@id/stock" />

            <ImageView
                android:id="@+id/addToBagImg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/bag"
                app:layout_constraintBottom_toBottomOf="@id/addToBag"
                app:layout_constraintEnd_toStartOf="@id/bagText"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@id/addToBag"
                app:layout_constraintTop_toTopOf="@id/addToBag"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/bagText"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="Move to Bag"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/addToBag"
                app:layout_constraintEnd_toEndOf="@id/addToBag"
                app:layout_constraintStart_toEndOf="@id/addToBagImg"
                app:layout_constraintTop_toTopOf="@id/addToBag" />

            <TextView
                android:id="@+id/deliveryAndServices"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Delivery &amp; Services"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/buyNow"
                app:layout_constraintTop_toBottomOf="@id/buyNow" />

            <View
                android:id="@+id/addressBox"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rectangular_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/deliveryAndServices" />

            <ImageView
                android:id="@+id/locationImg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/location"
                app:layout_constraintBottom_toBottomOf="@id/addressBox"
                app:layout_constraintStart_toStartOf="@id/addressBox"
                app:layout_constraintTop_toTopOf="@id/addressBox" />

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="Dean"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/addressBox"
                app:layout_constraintEnd_toStartOf="@id/profileAddress"
                app:layout_constraintStart_toEndOf="@id/locationImg"
                app:layout_constraintTop_toTopOf="@id/addressBox" />

            <TextView
                android:id="@+id/profileAddress"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="- Steet 1, House 1"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@id/addressBox"
                app:layout_constraintStart_toEndOf="@id/profileName"
                app:layout_constraintTop_toTopOf="@id/addressBox" />

            <TextView
                android:id="@+id/change"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="Change"
                android:textColor="#ff9248"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/addressBox"
                app:layout_constraintEnd_toEndOf="@id/addressBox"
                app:layout_constraintTop_toTopOf="@id/addressBox" />

            <TextView
                android:id="@+id/shippingBy"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:text="Ships in 3-5 business days"
                android:textColor="#ff9248"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/addressBox"
                app:layout_constraintTop_toBottomOf="@id/addressBox" />

            <LinearLayout
                android:id="@+id/productDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rectangular_border"
                android:orientation="vertical"
                android:padding="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/shippingBy">


                <TextView
                    android:id="@+id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="Product Details"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/descriptionText"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toTopOf="@id/productDetails" />

                <TextView
                    android:id="@+id/descriptionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="The Essence Mascara Lash Princess is a popular mascara known for its volumizing and lengthening effects. Achieve dramatic lashes with this long-lasting and cruelty-free formula."
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toTopOf="@id/stockHeader"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/description" />

                <TextView
                    android:id="@+id/stockHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Stock"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/stockText"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/descriptionText" />

                <TextView
                    android:id="@+id/stockText"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:text="Available at present - 99"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toTopOf="@id/warranty"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/stockHeader" />

                <TextView
                    android:id="@+id/warranty"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="Warranty Information"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/warrantyText"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/stockText" />

                <TextView
                    android:id="@+id/warrantyText"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:text="1 week warranty"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toTopOf="@id/returnPolicy"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/warranty" />

                <TextView
                    android:id="@+id/returnPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="Return Policy"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/returnText"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/warrantyText" />

                <TextView
                    android:id="@+id/returnText"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:text="No return policy"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@id/productDetails"
                    app:layout_constraintTop_toBottomOf="@id/returnPolicy" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>